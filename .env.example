# =============================================================================
# Voice2Law frontend — Google Sign-In + Express API
# =============================================================================
#
# SETUP (one-time):
# 1. Google Cloud Console (https://console.cloud.google.com/apis/credentials)
#    - Create or open a Web application OAuth 2.0 client
#    - Authorized JavaScript origins: http://localhost:5173 and http://localhost:5174
#    - If OAuth app is in "Testing", add your Gmail under OAuth consent screen → Test users
# 2. Copy this file to `.env` in the project root and paste your Web client ID below
# 3. Set the same client ID + JWT_SECRET in backend/.env (see backend/.env.example)
# 4. Restart the Vite dev server after changing `.env` (npm run dev)
#
# Firebase is optional — only needed for document storage uploads in the admin panel.
# =============================================================================

# Backend API base URL (local Express wrapper with /api prefix)
VITE_API_URL=http://localhost:5000/api

# ---- Google Sign-In (required) ----
# Web client ID from Google Cloud Console → Credentials → OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=

# ---- Firebase Web SDK (optional — admin document uploads only) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Voice STT: webspeech (browser, needs Chrome/Edge + internet) | whisper | elevenlabs | auto
# Server fallback uses nlp-service POST /transcribe when browser speech fails.
VITE_STT_ENGINE=webspeech
VITE_NLP_SERVICE_URL=http://localhost:8001
