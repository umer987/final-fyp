# Voice2Law backend — Express API on port 5000 with /api prefix.
# PRIMARY answer engine = RAG via the NLP service (nlp-service, FastAPI on 8001).
# Firestore powers the admin/data routes; OpenAI is an optional fallback only.

PORT=5000

# Frontend origin(s) for CORS (comma-separated)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# ---- RAG / NLP service (PRIMARY — required for legal answers) ----
# The backend POSTs questions to ${NLP_SERVICE_URL}/ask and returns the RAG answer.
NLP_SERVICE_URL=http://127.0.0.1:8001
# Max wait for an /ask response (ms). RAG is ~2s uncached, ~20ms cached.
NLP_TIMEOUT_MS=45000
# Max wait for /tts (ms) — providers can be slow on cold start.
NLP_TTS_TIMEOUT_MS=120000
# Max characters synthesized for voice playback (full answer still shown on screen).
MAX_TTS_CHARS=1500
# How long to cache the NLP /health probe used by /api/health (ms).
NLP_HEALTH_CACHE_MS=30000

# ---- Google OAuth + JWT sessions (required for sign-in) ----
# Same Web client ID as frontend VITE_GOOGLE_CLIENT_ID (no client secret needed for ID token flow).
GOOGLE_CLIENT_ID=your_google_client_id
# Random secret for signing session JWTs — generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
# Comma-separated Google account emails that receive admin role on sign-in
ADMIN_EMAILS=admin@example.com

# ---- Firebase Admin SDK (optional — Firestore data routes only) ----
# Without a service account, RAG answers (/api/ai/*) and Google sign-in still work.
# Firestore-backed admin routes return empty lists or 503.
#
# Download JSON: Firebase Console → Project settings → Service accounts →
#   Generate new private key → save as backend/service-account.json (gitignored)
#
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# FIREBASE_PROJECT_ID=your-firebase-project-id

# ---- OpenAI (OPTIONAL — secondary fallback when the NLP service is down) ----
# Leave empty to rely solely on RAG. If set, used ONLY when nlp-service is unreachable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
