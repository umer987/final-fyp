# =============================================================================
# Voice2Law — production environment snippets (copy to real .env files on EC2)
# NEVER commit filled-in copies. Replace placeholders before deploy.
# =============================================================================

# -----------------------------------------------------------------------------
# FILE: /home/ubuntu/voice2law/.env   (frontend — read at `npm run build` time)
# -----------------------------------------------------------------------------
VITE_API_URL=https://YOUR_DOMAIN_OR_IP/api
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Browser speech works without exposing NLP. Use webspeech in production unless
# you add a backend STT proxy route.
VITE_STT_ENGINE=webspeech

# Optional Firebase (admin document uploads only)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Do NOT set VITE_NLP_SERVICE_URL in production — NLP stays on 127.0.0.1:8001
# and is reached only by the Express backend.


# -----------------------------------------------------------------------------
# FILE: /home/ubuntu/voice2law/backend/.env
# -----------------------------------------------------------------------------
PORT=5000

# Your public site origin(s) for CORS (comma-separated)
CLIENT_URL=https://YOUR_DOMAIN_OR_IP

# NLP microservice — localhost only (not in security group)
NLP_SERVICE_URL=http://127.0.0.1:8001
NLP_TIMEOUT_MS=45000
NLP_TTS_TIMEOUT_MS=120000
MAX_TTS_CHARS=1500
NLP_HEALTH_CACHE_MS=30000

GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
JWT_SECRET=GENERATE_WITH_openssl_rand_-base64_32
JWT_EXPIRES_IN=7d
ADMIN_EMAILS=your-admin@gmail.com

# Optional: Firebase Admin for Firestore admin routes
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional OpenAI fallback when NLP is down
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini


# -----------------------------------------------------------------------------
# FILE: /home/ubuntu/voice2law/nlp-service/.env
# -----------------------------------------------------------------------------
NLP_PORT=8001

# Free tier: Hugging Face read token — https://huggingface.co/settings/tokens
HF_TOKEN=hf_YOUR_TOKEN_HERE
HF_INFERENCE_ENDPOINT=https://router.huggingface.co/hf-inference

LLM_PROVIDER=huggingface
HF_LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
HF_LLM_INFERENCE_PROVIDER=auto

STT_PROVIDER=huggingface
HF_STT_MODEL=openai/whisper-large-v3

TTS_PROVIDER=huggingface
HF_TTS_MODEL=facebook/mms-tts-urd

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_DIR=./data/chroma
ANONYMIZED_TELEMETRY=False

# Fast FYP demo (optional — uncomment for quicker /ask during presentation)
# LLM_EXTRACTIVE_ONLY=true
# RETRIEVAL_K=2
# RETRIEVAL_MAX_QUERIES=1
# MAX_CONTEXT_CHARS=800

LLM_EXTRACTIVE_ONLY=false
RETRIEVAL_K=5
RETRIEVAL_MAX_QUERIES=2
MAX_CONTEXT_CHARS=1600
LLM_MAX_TOKENS_URDU=750
LLM_TIMEOUT_SECONDS=90
ANSWER_CACHE_MIN_CHARS=550
TTS_MAX_CHARS=1500

ANSWER_LANGUAGE=urdu

# OCR: tesseract (free, local) or azure (faster, needs Azure key)
OCR_ENGINE=tesseract
# OCR_ENGINE=azure
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=your_key_here
