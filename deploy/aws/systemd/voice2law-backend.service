[Unit]
Description=Voice2Law Backend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/voice2law/backend
Environment=NODE_ENV=production
EnvironmentFile=/etc/voice2law/backend.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
