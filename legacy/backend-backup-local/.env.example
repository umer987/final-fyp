# ---- Voice2Law backend environment variables ----
# Copy this file to ".env" and adjust the values for your machine.
# On Windows PowerShell:  Copy-Item .env.example .env

# Port the Express server listens on
PORT=5000

# MongoDB connection string.
# Local MongoDB:   mongodb://127.0.0.1:27017/voice2law
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/voice2law
MONGODB_URI=mongodb://127.0.0.1:27017/voice2law

# Secret used to sign JWT tokens. Use a long random string in production.
JWT_SECRET=change_this_secret

# How long a login token stays valid (e.g. 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# Frontend origin(s) for CORS (comma-separated). Include 5174 if Vite picks the next port.
# In development (NODE_ENV != production), any http://localhost:<port> is also allowed.
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Google OAuth (SPA ID token verification). Create credentials at:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
# Optional for ID-token-only flow; not used when verifying frontend credentials.
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---- Speech-to-text (POST /api/voice) ----
# whisper     = FREE default — forwards audio to NLP/voice2law Whisper HTTP service
# webspeech   = browser sends transcript only (no server STT; use Chrome)
# elevenlabs  = paid Scribe API (requires speech_to_text permission on the key)
STT_ENGINE=whisper

# Whisper HTTP endpoint (nlp-service POST /transcribe or voice2law local Whisper)
# NLP service default port is 8001 (port 8000 may be blocked on Windows: WinError 10013).
# Keep STT_SERVICE_URL and NLP_SERVICE_URL on the SAME port the NLP boot banner prints.
STT_SERVICE_URL=http://localhost:8001/transcribe

# ElevenLabs Scribe — only when STT_ENGINE=elevenlabs (never expose in the frontend)
# https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=your_elevenlabs_api_key

# ---- NLP microservice for real legal answers (FastAPI, default port 8001) ----
# Base URL or full /ask URL — both work. Must match STT_SERVICE_URL's port.
NLP_SERVICE_URL=http://localhost:8001

# Urdu TTS is configured in nlp-service/.env (TTS_PROVIDER=elevenlabs,
# ELEVENLABS_API_KEY, ELEVENLABS_TTS_VOICE_ID, ELEVENLABS_TTS_MODEL).
# Backend POST /api/tts proxies to NLP POST /tts — no ElevenLabs key needed here
# unless you also use STT_ENGINE=elevenlabs above.
