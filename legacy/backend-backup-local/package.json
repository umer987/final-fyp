{
  "name": "voice2law-backend",
  "version": "1.0.0",
  "description": "Backend API for Voice2Law — a bilingual (Urdu/English) Pakistani legal information assistant.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "scrape:lawyers": "node src/scripts/scrapeWakeelOnline.js",
    "seed:lawyers": "node src/scripts/scrapeWakeelOnline.js --import --seed"
  },
  "keywords": [
    "voice2law",
    "legal",
    "urdu",
    "express",
    "mongodb"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "express-rate-limit": "^7.4.1",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
