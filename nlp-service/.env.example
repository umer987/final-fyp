# Copy this file to .env and fill in the blanks.
# cp .env.example .env   (PowerShell: Copy-Item .env.example .env)

# --- Service ---
NLP_PORT=8001
# Optional CORS allowlist (comma-separated). Empty or * = http://localhost:5000,5173,5174
# CORS_ORIGINS=

# =========================================================================== #
# FREE DEFAULT: Hugging Face Inference API (LLM + STT + Urdu TTS)
# =========================================================================== #
# Get a FREE token at: https://huggingface.co/settings/tokens  (a "read" token).
# This single token powers the LLM, speech-to-text and text-to-speech below.
HF_TOKEN=
# Router endpoint (api-inference.huggingface.co is deprecated).
HF_INFERENCE_ENDPOINT=https://router.huggingface.co/hf-inference

# --- LLM provider ---
# Options: huggingface (free, default) | openai (paid)
LLM_PROVIDER=huggingface
# Multilingual instruct model (Urdu + English). Uses Inference Providers router (auto).
# Accept the Llama license on the model card before first use.
# Faster demo: Llama-3.2-3B-Instruct. Higher quality (slower): Llama-3.1-8B-Instruct
HF_LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
# Router: auto = fastest provider that hosts the model (free-tier credits).
# Do NOT set hf-inference for 7B-class instruct models — that provider is CPU/small-model only.
HF_LLM_INFERENCE_PROVIDER=auto
# Fallbacks if cold / rate-limited (enable providers at hf.co/settings/inference-providers):
#   meta-llama/Llama-3.2-3B-Instruct
#   HuggingFaceH4/zephyr-7b-beta

# --- Speech-to-Text provider ---
# Options: huggingface (free HF Inference Whisper) | elevenlabs (paid) | groq (Whisper via Groq)
# Node backend POST /api/voice (STT_ENGINE=whisper) calls POST /transcribe on this service.
STT_PROVIDER=huggingface
HF_STT_MODEL=openai/whisper-large-v3
# Fallback chain when primary STT fails (SSL blips, cold start, rate limits).
# Example with ElevenLabs primary: STT_FALLBACK_ORDER=huggingface,groq
# STT_FALLBACK_ORDER=
# STT_RETRY_ATTEMPTS=3
# STT_RETRY_BACKOFF_SECONDS=1.0
# GROQ_STT_API_KEY=   # optional; uses LLM_FALLBACK_API_KEY when empty
# GROQ_STT_MODEL=whisper-large-v3
# For fully local Whisper (no HF token), run voice2law on another port and set in backend:
#   STT_SERVICE_URL=http://localhost:8001/transcribe

# --- Text-to-Speech provider ---
# Options: huggingface (free, default) | elevenlabs (paid)
TTS_PROVIDER=huggingface
# Urdu TTS model (Meta MMS).
HF_TTS_MODEL=facebook/mms-tts-urd

# =========================================================================== #
# OPTIONAL paid path (only used when the providers above are switched)
# =========================================================================== #
# --- LLM (OpenAI-compatible API), used when LLM_PROVIDER=openai ---
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# Google AI Studio / Gemini (OpenAI-compatible; key at https://aistudio.google.com/apikey):
#   LLM_PROVIDER=openai
#   LLM_API_KEY=your_google_ai_studio_key
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.0-flash
#   # fallback if 2.0 unavailable: gemini-1.5-flash
#   LLM_EXTRACTIVE_ONLY=false
# Groq fallback when primary OpenAI-compatible LLM fails (429, timeout, etc.):
#   LLM_FALLBACK_API_KEY=gsk_your_groq_key
#   LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
#   LLM_FALLBACK_MODEL=llama-3.1-8b-instant
#   LLM_OPENAI_FALLBACK=true

# --- ElevenLabs (STT + TTS), used when STT_PROVIDER/TTS_PROVIDER=elevenlabs ---
# ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_TTS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# --- Embeddings (multilingual, runs LOCALLY & FREE via sentence-transformers) ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Vector store (ChromaDB persistent dir) ---
CHROMA_DIR=./data/chroma
# Disable Chroma telemetry (avoids posthog capture() errors in logs).
ANONYMIZED_TELEMETRY=False

# --- RAG /ask tuning (optional) ---
# Restart nlp-service after changing these values.
# Skip remote LLM entirely — instant Urdu answer from top Chroma excerpts (fastest /ask).
# FAST DEMO (copy these into .env for FYP presentation — fastest /ask, no HF router wait):
#   LLM_EXTRACTIVE_ONLY=true
#   RETRIEVAL_K=2
#   RETRIEVAL_MAX_QUERIES=1
#   MAX_CONTEXT_CHARS=800
#   LLM_MAX_TOKENS_URDU=250
#   LLM_TIMEOUT_SECONDS=60
# BALANCED (default below): fuller Gemini/Groq Urdu answers from more context.
LLM_EXTRACTIVE_ONLY=false
RETRIEVAL_K=5
RETRIEVAL_MAX_QUERIES=2
MAX_CONTEXT_CHARS=1600
LLM_MAX_TOKENS_URDU=750
LLM_TIMEOUT_SECONDS=90
# Skip cached answers shorter than this — brief demo entries re-run RAG + LLM.
ANSWER_CACHE_MIN_CHARS=550
# Max characters sent to TTS (display shows full answer; voice reads up to this limit).
TTS_MAX_CHARS=1500

# --- FAST LLM alternatives (optional — switch LLM_PROVIDER=openai) ---
# Google AI Studio / Gemini (see block above under "LLM (OpenAI-compatible API)")
# Groq (sub-second inference, free tier):
#   LLM_PROVIDER=openai
#   LLM_API_KEY=gsk_your_groq_key
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.1-8b-instant
# Local Ollama (offline, no rate limits):
#   LLM_PROVIDER=openai
#   LLM_API_KEY=ollama
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODEL=llama3.2:3b-instruct-q4_K_M

# --- OCR ---
# Options: tesseract (slow, local, free) | azure (fast, cloud, uses Azure credits)
OCR_ENGINE=azure
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_key_here
TESSERACT_CMD=

# --- Answers ---
ANSWER_LANGUAGE=urdu
